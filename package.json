{
  "name": "medmanager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --log-override:empty-import-meta=silent --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "db:dev": "supabase db push --db-url $SUPABASE_DB_URL_DEV",
    "db:prod": "supabase db push --db-url $SUPABASE_DB_URL_PROD"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/express": "^5.0.6",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "lucide-react": "^0.564.0",
    "micro": "^10.0.1",
    "motion": "^12.34.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "stripe": "^22.1.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "node-domexception": "1.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@types/micro": "^7.3.7",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^5.6.15",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
